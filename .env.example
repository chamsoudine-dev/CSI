# Base de données PostgreSQL
DATABASE_URL=postgresql://postgres:motdepasse@localhost:5432/csi_niger

# Sécurité JWT (OBLIGATOIRE en production — changez cette valeur !)
JWT_SECRET=changez-cette-cle-secrete-longue-et-aleatoire-en-production

# Compte admin initial (utilisé par: npm run seed)
ADMIN_EMAIL=admin@csi-niger.ne
ADMIN_PASSWORD=Admin@CSI2024
ADMIN_NOM=Administrateur National

# Configuration serveur
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# SSL base de données (mettre 'true' si votre hébergeur requiert SSL)
DATABASE_SSL=false

# Origines autorisées pour CORS (séparées par virgule, vide = toutes)
ALLOWED_ORIGINS=http://localhost:3000

# Durée de validité du token JWT
JWT_EXPIRES=7d
