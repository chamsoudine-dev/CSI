# ─────────────────────────────────────────────────────────────────────────────
# CSI NIGER — Modèle de configuration (.env.example)
# Copiez ce fichier vers ".env" et renseignez vos paramètres secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de données PostgreSQL ───────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:motdepasse_securise@localhost:5432/csi_niger
DATABASE_SSL=false

# ── Sécurité & Tokens JWT (OBLIGATOIRE en production) ────────────────────────
# Clé secrète robuste (min. 32 caractères aléatoires)
JWT_SECRET=changez-cette-cle-secrete-longue-et-aleatoire-en-production
# Secret HMAC dédié aux codes e-mail (optionnel, utilise JWT_SECRET sinon)
OTP_SECRET=changez-aussi-ce-secret-aleatoire-en-production
# Durée de validité du token (ex: 8h, 24h, 7d) — défaut 8h
JWT_EXPIRES=8h

# ── Envoi des codes de connexion et récupération par SMTP ────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── Reverse Proxy & Sécurité Réseau ──────────────────────────────────────────
# Configuration de Express trust proxy (1 = reverse proxy direct comme Nginx ou Docker bridge)
TRUST_PROXY=1
# Origines autorisées pour CORS (séparées par des virgules, vide = toutes)
ALLOWED_ORIGINS=http://localhost:3000

# ── Compte Administrateur National Initial ───────────────────────────────────
# Créé automatiquement au premier démarrage par seed_admin.js
ADMIN_EMAIL=admin@csi-niger.ne
ADMIN_PASSWORD=ChangeZ_Admin_Password2024!
ADMIN_NOM=Administrateur National

# ── Initialisation de Données (Seeds) ─────────────────────────────────────────
# Activer à true uniquement pour pré-charger les profils et CSI de démonstration
SEED_DEMO=false
# Chemin personnalisé du catalogue CSV de médicaments (optionnel)
CATALOGUE_CSV_PATH=./catalogue_niger.csv

# ── Configuration du Serveur Node.js ──────────────────────────────────────────
PORT=3000
APP_PORT=3000
NODE_ENV=development
LOG_LEVEL=info
